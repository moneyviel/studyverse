 "g1-english-04-03": {
  "type": "storysequence",
  "p": {
   "title": "Raju and the Bell",
   "kind": "story",
   "challenge": "What happened first? Put the story in order: beginning, middle and end",
   "panels": [
    [
     "🔔",
     "Raju had a shiny red bell."
    ],
    [
     "🌳",
     "He sat under a neem tree to rest."
    ],
    [
     "🐒",
     "Mini the monkey took the bell and climbed up the tree."
    ],
    [
     "💡",
     "Raju had an idea. He clapped his hands."
    ],
    [
     "👏",
     "Mini clapped too! The bell fell down."
    ],
    [
     "😊",
     "Raju picked up his bell."
    ]
   ]
  }
 },

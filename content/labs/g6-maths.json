 "g6-maths-03-14": {
  "type": "flowchart",
  "p": {
   "title": "Kaprekar's routine as a procedure",
   "task": "arrange",
   "challenge": "Put the steps of Kaprekar's procedure in order, so a computer could follow them exactly",
   "nodes": [
    {
     "id": "a",
     "emoji": "🔢",
     "text": "Take a 4-digit number (digits not all the same)",
     "info": "For example, 2013."
    },
    {
     "id": "b",
     "emoji": "⬇️",
     "text": "Arrange the digits from largest to smallest",
     "info": "2013 → 3210"
    },
    {
     "id": "c",
     "emoji": "⬆️",
     "text": "Arrange the digits from smallest to largest",
     "info": "2013 → 0123 (keep the zero)"
    },
    {
     "id": "d",
     "emoji": "➖",
     "text": "Subtract the smaller from the larger",
     "info": "3210 − 0123 = 3087"
    },
    {
     "id": "q",
     "emoji": "❓",
     "text": "Is the answer 6174?",
     "type": "decision",
     "info": "If not, repeat with the answer: 8730 − 0378 = 8352, then 8532 − 2358 = 6174."
    },
    {
     "id": "e",
     "emoji": "🏁",
     "text": "Stop: 6174 reached",
     "info": "7641 − 1467 = 6174, so it comes back to itself."
    }
   ],
   "edges": [
    {
     "from": "a",
     "to": "b"
    },
    {
     "from": "b",
     "to": "c"
    },
    {
     "from": "c",
     "to": "d"
    },
    {
     "from": "d",
     "to": "q"
    },
    {
     "from": "q",
     "to": "e",
     "label": "Yes"
    },
    {
     "from": "q",
     "to": "b",
     "label": "No"
    }
   ],
   "order": [
    "a",
    "b",
    "c",
    "d",
    "q",
    "e"
   ]
  }
 },

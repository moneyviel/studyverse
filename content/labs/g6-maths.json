     "text": "56 and 45",
     "bin": 0,
     "why": "56 = 2×2×2×7, 45 = 3×3×5: no common prime."
    },
    {
     "text": "8 and 15",
     "bin": 0,
     "why": "8 = 2×2×2, 15 = 3×5: no common prime."
    },
    {
     "text": "14 and 25",
     "bin": 0,
     "why": "14 = 2×7, 25 = 5×5: no common prime."
    },
    {
     "text": "35 and 18",
     "bin": 0,
     "why": "35 = 5×7, 18 = 2×3×3: no common prime."
    },
    {
     "text": "12 and 168",
     "bin": 1,
     "why": "Both have 2 and 3 as factors."
    },
    {
     "text": "9 and 21",
     "bin": 1,
     "why": "Both have 3 as a factor."
    },
    {
     "text": "30 and 42",
     "bin": 1,
     "why": "Both have 2 and 3 as factors."
    },
    {
     "text": "26 and 39",
     "bin": 1,
     "why": "Both have 13 as a factor."
    }
   ]
  }
 },

 "g6-maths-03-11": {
  "type": "flowchart",
  "p": {
   "title": "The Collatz game",
   "task": "play",
   "challenge": "Play the Collatz rule starting from 12: at each question, choose Yes or No yourself. 12 → 6 → 3 → 10 → 5 → 16 → 8 → 4 → 2 → 1",
   "nodes": [
    {
     "id": "s",
     "emoji": "🔢",
     "text": "Take a number",
     "info": "Start with 12."
    },
    {
     "id": "one",
     "emoji": "❓",
     "text": "Is it 1?",
     "type": "decision",
     "info": "If you have reached 1, the chain stops."
    },
    {
     "id": "ev",
     "emoji": "⚖️",
     "text": "Is it even?",
     "type": "decision",
     "info": "12 is even. 3 is odd."
    },
    {
     "id": "h",
     "emoji": "✂️",
     "text": "Halve it",
     "info": "12 → 6, 6 → 3, 10 → 5, 16 → 8 → 4 → 2 → 1. A power of 2 keeps halving down to 1."
    },
    {
     "id": "t",
     "emoji": "✖️",
     "text": "Multiply by 3 and add 1",
     "info": "3 → 3 × 3 + 1 = 10. 5 → 5 × 3 + 1 = 16."
    },
    {
     "id": "e",
     "emoji": "🏁",
     "text": "Stop: you reached 1",
     "info": "From 12 it takes 9 steps. Nobody has proved every number reaches 1!"
    }
   ],
   "edges": [
    {
     "from": "s",
     "to": "one"
    },
    {
     "from": "one",
     "to": "ev",
     "label": "No"
    },
    {
     "from": "one",
     "to": "e",
     "label": "Yes"
    },
    {
     "from": "ev",
     "to": "h",
     "label": "Yes"
    },
    {
     "from": "ev",
     "to": "t",
     "label": "No"
    },
    {
     "from": "h",
     "to": "one"
    },
    {
     "from": "t",
     "to": "one"
    }
   ]
  }
 },

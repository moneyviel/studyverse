    {
     "text": "नन्हे पंख तुम्हारे फैलें, नीला हो आकाश।",
     "meaning": "पंख फैलाना = आगे बढ़ना"
    },
    {
     "text": "राह कठिन हो, फिर भी मन में बना रहे विश्वास।"
    },
    {
     "text": "गिरकर उठना, उठकर चलना, सीखो हर दिन बात।"
    },
    {
     "text": "तुम्हें मिले उजियारा इतना, बाँट सको दिन-रात।",
     "meaning": "उजियारा = ज्ञान या खुशी"
    }
   ]

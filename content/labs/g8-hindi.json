   ],
   "items": [
    {
     "text": "गौरैया दाना चुगती है।",
     "bin": 0,
     "why": "क्या चुगती है? दाना — कर्म है, इसलिए सकर्मक।"
    },
    {
     "text": "माँ ने छत पर पानी रखा।",
     "bin": 0,
     "why": "क्या रखा? पानी — सकर्मक।"
    },
    {
     "text": "बल्लेबाज़ ने गेंद मारी।",
     "bin": 0,
     "why": "क्या मारी? गेंद — सकर्मक।"
    },
    {
     "text": "राधा पत्र लिखती है।",
     "bin": 0,
     "why": "क्या लिखती है? पत्र — सकर्मक।"
    },
    {
     "text": "गौरैया उड़ती है।",
     "bin": 1,
     "why": "\"क्या उड़ती है?\" का उत्तर नहीं — कर्म नहीं, अकर्मक।"
    },
    {
     "text": "गेंद सीमा के पार गई।",
     "bin": 1,
     "why": "जाना का फल कर्ता (गेंद) पर — अकर्मक।"
    },
    {
     "text": "बच्चा हँसता है।",
     "bin": 1,
     "why": "हँसने का कोई कर्म नहीं — अकर्मक।"
    },
    {
     "text": "मोहन सोता है।",
     "bin": 1,
     "why": "\"क्या सोता है?\" का उत्तर नहीं — अकर्मक।"
    }
   ]
  }
 },

 "g8-hindi-02-01": {
  "type": "storysequence",
  "p": {
   "title": "बुलबुल का घोंसला",
   "kind": "story",
   "challenge": "करुणा की कहानी को सही क्रम में लगाओ — अंत में किसका मन बदला?",
   "panels": [
    {
     "e": "🌹",
     "t": "अनु की बालकनी में गुलाब के गमले के पास बुलबुल ने घोंसला बनाया।"
    },
    {
     "e": "😤",
     "t": "भैया बोला, \"इसे हटा दो, यहाँ तिनके गिरते हैं।\""
    },
    {
     "e": "🥚",
     "t": "अनु ने कहा, \"बस कुछ दिनों की बात है, इसमें अंडे हैं।\""
    },
    {
     "e": "🐣",
     "t": "दस दिन बाद घोंसले से चूँ-चूँ की आवाज़ आई।"
    },
    {
     "e": "😊",
     "t": "भैया भी मुस्कुराकर नन्हे बच्चों को देखने लगा।"
    }
   ]
  }
 },
 "g8-hindi-02-02": {
  "type": "sentencebuilder",
  "p": {
   "mode": "order",
   "goal": 4,
   "challenge": "भावों के मुहावरों वाले 4 वाक्य सही क्रम में बनाओ",
   "items": [
    {
     "text": "घायल पिल्ले को देखकर दादी का दिल पसीज गया।",
     "meaning": "दिल पसीजना = दया आना"
    },
    {
     "text": "विदाई के समय सबकी आँखें भर आईं।",
     "meaning": "आँखें भर आना = आँसू आ जाना"
    },
    {
     "text": "इनाम पाकर मीना फूली न समाई।",
     "meaning": "फूले न समाना = बहुत खुश होना"
    },
    {
     "text": "साँप देखकर उसके हाथ-पाँव फूल गए।",
     "meaning": "हाथ-पाँव फूलना = घबरा जाना"
    }
   ]
  }
 },
 "g8-hindi-02-03": {
  "type": "sortbins",
  "p": {
   "title": "सकर्मक या अकर्मक?",
   "mode": "check",
   "challenge": "क्रिया से पहले \"क्या/किसे\" पूछो — उत्तर मिले तो सकर्मक, न मिले तो अकर्मक। सब वाक्य छाँटकर ✔ Check दबाओ।",

 "g7-sanskrit-02-02": {
  "type": "sentencebuilder",
  "p": {
   "mode": "order",
   "goal": 4,
   "challenge": "सीख भरी पंक्तियाँ क्रम से बनाओ और उनका अर्थ पढ़ो",
   "items": [
    {
     "text": "प्रतिदिनं यः पठति, सः ज्ञानं लभते।",
     "meaning": "जो रोज़ पढ़ता है, वह ज्ञान पाता है।"
    },
    {
     "text": "सत्यं वद, प्रियं वद, सदा मधुरं वद।",
     "meaning": "सच बोलो, प्रिय बोलो, सदा मीठा बोलो।"
    },
    {
     "text": "वृक्षाः अन्येभ्यः फलानि यच्छन्ति।",
     "meaning": "पेड़ दूसरों को फल देते हैं।"
    },
    {
     "text": "सज्जनाः अपि परोपकारं कुर्वन्ति।",
     "meaning": "अच्छे लोग भी दूसरों की भलाई करते हैं।"
    }
   ]
  }
 },

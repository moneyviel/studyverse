 "g6-english-05-01": {
  "type": "storysequence",
  "p": {
   "title": "A Friend's Prayer — stanza 1",
   "kind": "story",
   "challenge": "The rhyme scheme is AABB. Use the rhymes to put the lines in order, then tap Next for stanza 2",
   "panels": [
    [
     "👂",
     "Let me be the friend who listens well,"
    ],
    [
     "🤫",
     "Who keeps the secrets you choose to tell,"
    ],
    [
     "☂️",
     "Who shares an umbrella when rain falls down,"
    ],
    [
     "🙂",
     "And gently turns away your frown."
    ]
   ],
   "stories": [
    {
     "title": "A Friend's Prayer — stanza 2",
     "panels": [
      [
       "💗",
       "Let me be kind when you are wrong,"
      ],
      [
       "🤝",
       "And help you up and make you strong;"
      ],
      [
       "🎁",
       "For friendship isn't gold or gift —"
      ],
      [
       "🫶",
       "It's a hand held out, a heart to lift."
      ]
     ]
    }
   ]
  }
 },

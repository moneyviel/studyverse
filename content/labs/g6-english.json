 "g6-english-06-01": {
  "type": "storysequence",
  "p": {
   "title": "The old chair",
   "kind": "story",
   "challenge": "The chair tells its own story. Put the events in order.",
   "panels": [
    [
     "🪑",
     "I am an old wooden chair on Nani's verandah."
    ],
    [
     "🐈",
     "For forty years I have held visitors, grandchildren and one very fat cat."
    ],
    [
     "😟",
     "My legs creak now, and someone said, \"Let's throw it away.\""
    ],
    [
     "🎨",
     "Little Chintu painted my arms blue and said, \"You're my throne!\""
    ],
    [
     "😊",
     "I felt young again."
    ]
   ]
  }
 },
 "g6-english-06-03": {
  "type": "sentencebuilder",
  "p": {
   "mode": "transform",
   "fromLabel": "Two sentences",
   "toLabel": "Joined",
   "challenge": "Join each pair of sentences with the right conjunction (and, but, or, so, because)",
   "items": [
    {
     "from": "Meena's friend was crying. Meena sat beside her and listened.",
     "text": "Meena's friend was crying, so Meena sat beside her and listened.",
     "hint": "so shows a result"
    },
    {
     "from": "The chair felt sad. Someone wanted to throw it away.",
     "text": "The chair felt sad because someone wanted to throw it away.",
     "hint": "because gives a reason"
    },
    {
     "from": "The chair was old. Chintu loved it.",
     "text": "The chair was old, but Chintu loved it.",
     "hint": "but shows a contrast"
    }
   ],
   "extra": [
    "and",
    "or"
   ],
   "goal": 3
  }
 },

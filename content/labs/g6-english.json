 "g6-english-03-01": {
  "type": "storysequence",
  "p": {
   "title": "Dadaji's spectacles",
   "kind": "story",
   "challenge": "Put the events of the funny tale in order",
   "panels": [
    [
     "🚉",
     "At a busy railway station, a cheeky monkey snatched Dadaji's spectacles."
    ],
    [
     "🐒",
     "It leapt onto the roof of a tea stall."
    ],
    [
     "📣",
     "People shouted and waved, but the monkey only chattered."
    ],
    [
     "🍌",
     "Little Lata stayed calm and held up a banana."
    ],
    [
     "👓",
     "Plop! The monkey dropped the spectacles into Dadaji's lap."
    ],
    [
     "👏",
     "Everyone laughed and clapped."
    ]
   ]
  }
 },
 "g6-english-03-03": {
  "type": "punctuation",
  "p": {
   "challenge": "Add capital letters, commas, apostrophes, speech marks and end marks",
   "items": [
    "Lata said, \"Don't worry, Dadaji.\"",
    "Lata said, \"Wait, I have an idea.\"",
    "The monkey grabbed Dadaji's spectacles.",
    "We bought bananas, apples and guavas on Monday."
   ],
   "caps": true
  }
 },
 "g6-english-04-01": {
  "type": "storysequence",
  "p": {
   "title": "Tara and Bholu",
   "kind": "story",
   "challenge": "Put the story in order. How do Tara's feelings change?",
   "panels": [
    [
     "🏏",
     "Tara loved noisy cricket matches; Bholu loved quiet painting."
    ],
    [
     "😒",
     "\"We have nothing in common,\" Tara grumbled."
    ],
    [
     "🤕",
     "Tara hurt her ankle and had to sit at home for a week."
    ],
    [
     "🎨",
     "Bholu came over and taught her to paint the sunset."
    ],
    [
     "📣",
     "On Sports Day, Tara cheered louder than anyone for nervous Bholu."
    ]
   ]
  }
 },
 "g6-english-04-02": {
  "type": "storysequence",
  "p": {
   "title": "Akbar's line",
   "kind": "story",
   "challenge": "Put the anecdote in order",
   "panels": [
    [
     "👑",
     "Akbar drew a line on the floor."
    ],
    [
     "❓",
     "\"Make this line shorter without rubbing out any part of it,\" he said."
    ],
    [
     "🤔",
     "The courtiers were puzzled."
    ],
    [
     "✏️",
     "Birbal simply drew a longer line beside it."
    ],
    [
     "😄",
     "Now Akbar's line looked shorter!"
    ]
   ]
  }
 },

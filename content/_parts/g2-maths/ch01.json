{
 "n": 1,
 "title": "A Day at the Beach",
 "emoji": "🏖️",
 "topics": [
  {
   "id": "g2-maths-01-01",
   "title": "Counting in groups",
   "learn": {
    "hook": "The beach is full of shells! How can we count them fast?",
    "points": [
     "Put things in groups of the same size.",
     "Count group by group to find how many in all.",
     "Groups of 2, 5 or 10 are easy to count.",
     "Grouping does not change the total. It only makes counting easy."
    ],
    "example": {
     "q": "Aisha has 3 groups of 5 shells. How many shells?",
     "steps": ["First group: 5.", "Two groups: 5, 10.", "Three groups: 5, 10, 15."],
     "answer": "15 shells"
    },
    "reallife": "Mummy counts socks in pairs. The fruit seller counts bananas in bunches."
   },
   "games": [
    {
     "type": "match",
     "title": "Match the groups",
     "pairs": [["2 groups of 5", "10"], ["3 groups of 2", "6"], ["4 groups of 10", "40"], ["3 groups of 5", "15"], ["4 groups of 2", "8"]]
    },
    {
     "type": "truefalse",
     "title": "True or false?",
     "items": [
      ["4 groups of 2 make 8.", true, "2, 4, 6, 8. That is 8."],
      ["2 groups of 10 make 12.", false, "10, 20. That is 20, not 12."],
      ["Putting things in groups changes how many there are.", false, "The total stays the same. Groups only make counting easy."],
      ["5 groups of 5 make 25.", true, "5, 10, 15, 20, 25. That is 25."],
      ["3 groups of 10 make 30.", true, "10, 20, 30. That is 30."]
     ]
    }
   ],
   "quiz": [
    {
     "q": "Riya puts shells in 4 groups of 5. How many shells?",
     "options": ["20", "9", "45", "15"],
     "answer": 0,
     "explain": "Count by 5s for 4 groups: 5, 10, 15, 20.",
     "steps": ["5, 10, 15, 20", "4 groups of 5 = 20"],
     "mistake": "Adds 4 and 5 instead of counting 4 groups of 5",
     "check": "4*5",
     "visual": {"kind": "count", "emoji": "🐚", "n": 20, "groups": 4}
    },
    {
     "q": "Arjun makes 3 groups of 10 pebbles. How many pebbles?",
     "options": ["13", "20", "30", "40"],
     "answer": 2,
     "explain": "Count by 10s for 3 groups: 10, 20, 30.",
     "steps": ["10, 20, 30", "3 groups of 10 = 30"],
     "mistake": "Writes 1 and 3 together or adds 3 and 10",
     "check": "3*10",
     "visual": {"kind": "count", "emoji": "🪨", "n": 30, "groups": 3}
    },
    {
     "q": "There are 6 pairs of slippers on the sand. How many slippers?",
     "options": ["6", "8", "14", "12"],
     "answer": 3,
     "explain": "A pair is 2. Count by 2s six times: 2, 4, 6, 8, 10, 12.",
     "steps": ["1 pair = 2 slippers", "2, 4, 6, 8, 10, 12", "6 pairs = 12 slippers"],
     "mistake": "Counts pairs instead of slippers",
     "check": "6*2",
     "visual": {"kind": "count", "emoji": "🩴", "n": 12, "groups": 6}
    },
    {
     "q": "Meena counts starfish: 10, 20, 30, 40. How many groups of 10 is that?",
     "options": ["4", "40", "10", "3"],
     "answer": 0,
     "explain": "She said 4 numbers: 10, 20, 30, 40. So there are 4 groups of 10.",
     "steps": ["10 is 1 group, 20 is 2 groups", "30 is 3 groups, 40 is 4 groups"],
     "mistake": "Gives the total instead of the number of groups",
     "check": "40/10",
     "visual": {"kind": "count", "emoji": "⭐", "n": 40, "groups": 4}
    },
    {
     "q": "Why do we count shells in groups?",
     "options": ["It makes the shells more", "It is quicker and easier", "It makes the shells fewer"],
     "answer": 1,
     "explain": "Groups help us count fast with fewer mistakes. The number of shells stays the same.",
     "mistake": "Thinks grouping changes the total"
    },
    {
     "q": "Kabir sees 2 groups of 5 crabs and 3 more crabs. How many crabs?",
     "options": ["10", "13", "15", "12"],
     "answer": 1,
     "explain": "2 groups of 5 is 10. Then 3 more: 11, 12, 13.",
     "steps": ["5, 10", "10 + 3 = 13"],
     "mistake": "Forgets the 3 extra crabs",
     "check": "2*5+3",
     "visual": {"kind": "count", "emoji": "🦀", "n": 13}
    }
   ],
   "teach": {
    "ask": "Gappu: There are so many shells! How can I count them quickly?",
    "must": [["group", "groups", "bunch", "bunches"], ["same", "equal", "each"]],
    "praise": "Wow! Make equal groups and count group by group. So fast!",
    "nudge": "Should I put them in groups? Must every group be the same size?"
   }
  },
  {
   "id": "g2-maths-01-02",
   "title": "Skip counting by 2s",
   "learn": {
    "hook": "Hop like a frog! Skip one number each time: 2, 4, 6, 8!",
    "points": [
     "Counting by 2s means adding 2 each time.",
     "2, 4, 6, 8, 10, 12 ... we jump over one number.",
     "We count eyes, ears, shoes and wheels of a cycle by 2s.",
     "Counting by 2s is faster than counting one by one."
    ],
    "example": {
     "q": "There are 5 pairs of shoes outside the beach hut. How many shoes?",
     "steps": ["Each pair has 2 shoes.", "Count by 2s: 2, 4, 6, 8, 10."],
     "answer": "10 shoes"
    },
    "reallife": "We count shoes at the temple door or wheels of cycles by 2s."
   },
   "games": [
    {
     "type": "fill",
     "title": "Fill the hop",
     "items": [
      {"text": "2, 4, ___, 8", "answer": "6", "options": ["5", "6", "7"]},
      {"text": "12, 14, 16, ___", "answer": "18", "options": ["18", "17", "20"]},
      {"text": "40, ___, 44", "answer": "42", "options": ["41", "43", "42"]},
      {"text": "___, 52, 54", "answer": "50", "options": ["51", "50", "53"]}
     ]
    },
    {
     "type": "order",
     "title": "Frog hops",
     "prompt": "Put them in order, counting by 2s",
     "items": ["14", "16", "18", "20", "22"]
    }
   ],
   "quiz": [
    {
     "q": "Count by 2s: 2, 4, 6, 8, ___. What comes next?",
     "options": ["9", "10", "12", "11"],
     "answer": 1,
     "explain": "Add 2 each time. 8 + 2 = 10.",
     "steps": ["8 + 2 = 10"],
     "mistake": "Counts on by 1 instead of 2",
     "check": "8+2",
     "visual": {"kind": "numberline", "from": 0, "to": 12, "marks": [2, 4, 6, 8, 10], "jumps": [[8, 10]]}
    },
    {
     "q": "Joseph counts slippers by 2s: 10, 12, 14, ___?",
     "options": ["15", "18", "16", "24"],
     "answer": 2,
     "explain": "Add 2 to 14. 14 + 2 = 16.",
     "steps": ["14 + 2 = 16"],
     "mistake": "Counts on by 1, or jumps by 4",
     "check": "14+2",
     "visual": {"kind": "numberline", "from": 10, "to": 20, "marks": [10, 12, 14, 16], "jumps": [[14, 16]]}
    },
    {
     "q": "5 children sit on the sand. Count their eyes by 2s. How many eyes?",
     "options": ["5", "7", "12", "10"],
     "answer": 3,
     "explain": "Each child has 2 eyes. 2, 4, 6, 8, 10.",
     "steps": ["2, 4, 6, 8, 10", "5 children have 10 eyes"],
     "mistake": "Counts children, not eyes",
     "check": "5*2",
     "visual": {"kind": "count", "emoji": "👁️", "n": 10, "groups": 5}
    },
    {
     "q": "Which number is missing? 20, 22, ___, 26",
     "options": ["24", "23", "25", "28"],
     "answer": 0,
     "explain": "Add 2 to 22. 22 + 2 = 24. Then 24 + 2 = 26.",
     "steps": ["22 + 2 = 24", "24 + 2 = 26"],
     "mistake": "Counts on by 1",
     "check": "22+2",
     "visual": {"kind": "numberline", "from": 20, "to": 28, "marks": [20, 22, 24, 26], "jumps": [[22, 24]]}
    },
    {
     "q": "Riya counts by 2s: 2, 4, 6, 9. Which number is wrong?",
     "options": ["2", "4", "6", "9"],
     "answer": 3,
     "explain": "After 6 comes 6 + 2 = 8, not 9. So 9 is wrong.",
     "steps": ["6 + 2 = 8", "She wrote 9, so 9 is wrong"],
     "mistake": "Does not check that each jump is 2",
     "check": "9"
    },
    {
     "q": "There are 4 cycles. Each cycle has 2 wheels. How many wheels?",
     "options": ["6", "8", "10", "4"],
     "answer": 1,
     "explain": "Count by 2s for 4 cycles: 2, 4, 6, 8.",
     "steps": ["2, 4, 6, 8", "4 cycles have 8 wheels"],
     "mistake": "Adds 4 and 2 instead of counting 2 for each cycle",
     "check": "4*2",
     "visual": {"kind": "count", "emoji": "🛞", "n": 8, "groups": 4}
    }
   ],
   "teach": {
    "ask": "Gappu: How do I count by 2s? Show me!",
    "must": [["2", "two"], ["add", "jump", "skip", "hop", "plus"]],
    "praise": "Yes! Add 2 every time: 2, 4, 6, 8. Hop hop!",
    "nudge": "How many do I add each time I hop?"
   }
  },

     "10 things make one group of ten."
    ],
    "example": {
     "q": "Arjun has 7 marbles. How many more does he need to make 10?",
     "steps": [
      "Start at 7.",
      "Count on: 8, 9, 10.",
      "That is 3 more."
     ],
     "answer": "3 more marbles"
    },
    "reallife": "Ten fingers help us count. A packet of 10 pencils is one ten."

   "title": "Sorting toys",
   "learn": {
    "hook": "Kabir's toys are all mixed up! Let us sort them.",
    "points": [
     "Sorting means putting things that are alike together.",
     "We can sort by colour, shape, size or kind.",
     "Each group shares something the same.",
     "The same toys can be sorted in different ways."
    ],
    "example": {
     "q": "Sort: 🚗 🧸 🚌 🪁 🚲. Which toys move on wheels?",
     "steps": [
      "🚗 has wheels.",
      "🚌 has wheels.",
      "🚲 has wheels.",
      "🧸 and 🪁 do not."
     ],
     "answer": "🚗, 🚌 and 🚲"
    },
    "reallife": "We sort clothes in a cupboard, spoons in a drawer and books on a shelf."
   },

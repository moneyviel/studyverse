  {
   "id": "g1-maths-13-03",
   "title": "Picture graphs",
   "learn": {
    "hook": "A picture graph shows counts with little pictures!",
    "points": [
     "Each picture stands for one thing.",
     "A row with more pictures means more things.",
     "We count the pictures in each row.",
     "We can see the most and the least quickly."
    ],
    "example": {
     "q": "Toys in class: Cars 🚗🚗🚗🚗, Balls ⚽⚽, Dolls 🪆🪆🪆. Which toy is the most?",
     "steps": [
      "Cars: 4.",
      "Balls: 2.",
      "Dolls: 3.",
      "4 is the biggest."
     ],
     "answer": "Cars"
    },
    "reallife": "Teachers make picture graphs of favourite fruits or how children come to school."
   },

    "points": [
     "We count 1, 2, 3, 4, 5, 6, 7, 8, 9.",
     "Each number is one more than the number before it.",
     "The last number we say tells how many.",
     "We can write numbers as digits: 1, 2, 3."
    ],
    "example": {
     "q": "What number comes just after 6?",
     "steps": [
      "Count: 1, 2, 3, 4, 5, 6.",
      "The next number is 7."

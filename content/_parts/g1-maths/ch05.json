   "title": "Taking away",
   "learn": {
    "hook": "Five birds sit on a wire. Two fly away. How many stay?",
    "points": [
     "Subtracting means taking away.",
     "We use the minus sign - to take away.",
     "Count back to find what is left.",
     "Taking away 0 leaves the same number."
    ],
    "example": {
     "q": "Kabir has 8 grapes. He eats 3. How many are left?",
     "steps": [
      "Start at 8.",
      "Count back 3: 7, 6, 5.",
      "8 - 3 = 5"
     ],
     "answer": "5 grapes"
    },
    "reallife": "When we eat sweets, the plate has fewer. When friends leave, fewer play."

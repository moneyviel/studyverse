  {
   "id": "g1-maths-06-01",
   "title": "Adding up to 20",
   "learn": {
    "hook": "The farm has lots of vegetables! Let us add them up.",
    "points": [
     "Start with the bigger number. Count on the smaller one.",
     "Make 10 first. Then add what is left.",
     "9 + 4: give 1 to 9 to make 10. Then 10 + 3 = 13.",
     "Changing the order gives the same sum. 3 + 8 = 8 + 3."
    ],
    "example": {
     "q": "Meena picks 8 carrots and 5 more. How many carrots?",
     "steps": [
      "Take 2 from 5 to make 8 into 10.",
      "3 are left from the 5.",
      "10 + 3 = 13"
     ],
     "answer": "13 carrots"
    },
    "reallife": "We add runs in cricket and coins in a piggy bank."
   },

    "points": [
     "Count back to take away.",
     "Or count up from the small number to the big one.",
     "15 - 5 = 10. Take away the ones to reach 10.",
     "Taking away makes the number smaller (unless we take away 0)."
    ],
    "example": {
     "q": "There are 14 cabbages. 6 are sold. How many are left?",
     "steps": [
      "Take away 4 to reach 10.",
      "Take away 2 more: 8.",
      "14 - 6 = 8"
     ],
     "answer": "8 cabbages"
    },
    "reallife": "When sweets get eaten or toys get given away, we subtract."

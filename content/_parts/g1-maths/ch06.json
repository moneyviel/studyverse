  {
   "id": "g1-maths-06-03",
   "title": "Farm word problems",
   "learn": {
    "hook": "Every farm has a story. Let us solve them!",
    "points": [
     "Read the story slowly.",
     "Find the numbers.",
     "Words like 'more come', 'in all', 'altogether' usually mean add.",
     "Words like 'left', 'gave away', 'ate' usually mean take away."
    ],
    "example": {
     "q": "Harpreet has 9 potatoes. Her dadi gives her 6 more. How many in all?",
     "steps": [
      "Numbers are 9 and 6.",
      "'More' and 'in all' tell us to add.",
      "9 + 6 = 15"
     ],
     "answer": "15 potatoes"
    },
    "reallife": "At the sabzi market we count what we buy and what is left."
   },
   "games": [
    {
     "type": "sort",
     "title": "Add or take away?",
     "buckets": [
      "Add",
      "Take away"
     ],
     "items": [
      [
       "How many in all?",
       0
      ],
      [
       "How many are left?",
       1
      ],
      [
       "She got 5 more",
       0
      ],
      [
       "He gave away 3",
       1
      ],
      [
       "How many altogether?",
       0
      ],
      [
       "The goat ate 4",
       1
      ]
     ]
    },
    {
     "type": "truefalse",
     "title": "True or false?",
     "items": [
      [
       "'In all' usually means we add.",
       true,
       "In all asks for the total."
      ],
      [
       "'How many are left' usually means we add.",
       false,
       "Left means some went away. We take away."
      ],
      [
       "10 hens and 5 more hens make 15 hens.",
       true,
       "10 + 5 = 15."
      ],
      [
       "12 eggs, 2 break. 14 eggs are left.",
       false,
       "Breaking means fewer. 12 - 2 = 10."
      ],
      [
       "8 + 8 = 16",
       true,
       "Double 8 is 16."
      ]
     ]
    }
   ],

  {
   "id": "g1-maths-08-01",
   "title": "Counting in tens",
   "learn": {
    "hook": "Counting big piles one by one is slow. Count in tens!",
    "points": [
     "10, 20, 30, 40, 50, 60, 70, 80, 90.",
     "Each step adds one more ten.",
     "3 tens is 30. 5 tens is 50.",
     "Ten tens make 100!"
    ],
    "example": {
     "q": "Joseph has 4 packets. Each packet has 10 toffees. How many toffees?",
     "steps": [
      "Count in tens: 10, 20, 30, 40.",
      "4 tens is 40."
     ],
     "answer": "40 toffees"
    },
    "reallife": "Shops pack biscuits and pencils in tens. ₹10 notes are counted in tens too."
   },
   "games": [
    {
     "type": "order",
     "title": "Count in tens",
     "prompt": "Smallest to biggest",
     "items": [
      "10",
      "20",
      "30",

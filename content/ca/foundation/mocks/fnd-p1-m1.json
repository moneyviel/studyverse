     "id": "a",
     "kind": "tf",
     "marks": 12,
     "q": "Say whether each statement below is true or false, giving a reason for your answer.",
     "items": [
      {
       "id": "t1",
       "s": "Trade discount allowed on a purchase is debited to Discount Account in the books of the buyer.",
       "answer": false,
       "reason": "False. Trade discount is deducted on the invoice itself and is never recorded; the purchase is entered at the net price.",
       "kw": [
        "not recorded|never recorded|net price|net amount|deducted invoice|no entry|not entered|not passed|net invoice|not accounted|not shown books|not debited"
       ],
       "min": 1
      },
      {
       "id": "t2",
       "s": "A contra entry in the cash book is not posted to the ledger.",
       "answer": true,
       "reason": "True. Both accounts affected — cash and bank — are already in the cash book, so no ledger posting is needed.",
       "kw": [
        "cash bank|both cash|both account|both side|cash book itself|already cash book|already recorded|already appear|both appear|both affected|both recorded|same book|within cash book"
       ],
       "min": 1
      },
      {
       "id": "t3",
       "s": "If the trial balance agrees, the books of account are free from errors.",
       "answer": false,
       "reason": "False. Errors of complete omission, principle, compensating errors and posting to a wrong account on the correct side do not affect agreement.",
       "kw": [
        "omission|principle|compensat|commission|errors not revealed|not disclosed|undisclosed|not affect agreement|arithmetical|arithmetic|wrong account|still errors|errors remain"
       ],
       "min": 1
      },
      {
       "id": "t4",
       "s": "Goods taken by the proprietor for personal use are credited to Sales Account.",
       "answer": false,
       "reason": "False. Drawings Account is debited and Purchases Account is credited, at cost, because no sale has taken place.",
       "kw": [
        "drawing",
        "purchase|cost|no sale|not sale|not sold"
       ],
       "min": 2
      },
      {
       "id": "t5",
       "s": "Nominal accounts are not carried forward to the next year.",
       "answer": true,
       "reason": "True. Expenses, losses, incomes and gains are closed by transfer to the Trading or Profit and Loss Account at the year end.",
       "kw": [
        "trading|profit loss|p l|closed|transfer|written off"
       ],
       "min": 1
      },
      {
       "id": "t6",
       "s": "A trader who deals in groceries records the credit purchase of a computer for office use in the purchases book.",
       "answer": false,
       "reason": "False. The purchases book records only credit purchases of goods dealt in; a credit purchase of an asset is recorded in the journal proper.",
       "kw": [
        "journal proper|journal",
        "asset|computer|not goods|goods dealt|only goods|not dealt|not stock|fixed asset"
       ],
       "min": 2
      }
     ]
